<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bandeja propia de aprobación de pagos, sin depender de otros módulos:
         abre las facturas de proveedor filtradas por «Pendientes de mi
         aprobación». Desde la lista se aprueba en lote (Acciones > Aprobar pago). -->
    <record id="action_vendor_bill_payment_approval" model="ir.actions.act_window">
        <field name="name">Pagos por aprobar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="search_view_id" ref="account.view_account_bill_filter"/>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_receipt'])]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True, 'search_default_payment_approval_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No tiene pagos de facturas para aprobar.
            </p>
            <p>
                Las facturas de proveedor quedan con el pago bloqueado hasta que
                las aprueba el aprobador de pagos del proveedor. Seleccione varias
                y use Acciones &gt; Aprobar pago para aprobarlas juntas.
            </p>
        </field>
    </record>

    <menuitem id="menu_vendor_bill_payment_approval"
              name="Pagos por aprobar"
              parent="account.menu_finance_payables"
              action="action_vendor_bill_payment_approval"
              sequence="2"/>

</odoo>
